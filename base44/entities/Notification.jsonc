{
  "name": "Notification",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n a la que pertenece este registro"
    },
    "profile_id": {
      "type": "string",
      "description": "ID del perfil al que pertenece esta notificaci\u00f3n"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cambio_asignacion",
        "retraso_ruta",
        "mensaje_despacho",
        "documento_vencido",
        "alerta_tarifa",
        "general"
      ],
      "default": "general"
    },
    "titulo": {
      "type": "string"
    },
    "mensaje": {
      "type": "string"
    },
    "leido": {
      "type": "boolean",
      "default": false
    },
    "destinatario": {
      "type": "string"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "default": "media"
    },
    "referencia_id": {
      "type": "string"
    },
    "referencia_tipo": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "mensaje"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}