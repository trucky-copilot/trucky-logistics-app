{
  "name": "Broker",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n a la que pertenece este registro"
    },
    "profile_id": {
      "type": "string",
      "description": "Opcional: ID del perfil espec\u00edfico al que pertenece este broker"
    },
    "nombre": {
      "type": "string"
    },
    "mc_number": {
      "type": "string"
    },
    "contacto": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "cargas_realizadas": {
      "type": "number",
      "default": 0
    },
    "tarifa_promedio": {
      "type": "number"
    },
    "dias_pago": {
      "type": "number",
      "description": "D\u00edas promedio de pago"
    },
    "puntaje_confiabilidad": {
      "type": "number",
      "description": "1-10"
    },
    "puntaje_pago": {
      "type": "number",
      "description": "1-10"
    },
    "clausulas_frecuentes": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "precaucion",
        "bloqueado"
      ],
      "default": "activo"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}