{
  "type": "object",
  "name": "Email",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizacion a la que pertenece este correo (aislamiento multi-tenant)"
    },
    "profile_id": {
      "type": "string",
      "description": "ID del perfil especifico (Carrier o Dispatcher) que gestiona este correo"
    },
    "remitente_nombre": {
      "type": "string",
      "description": "Nombre visible del remitente (ej. C.H. Robinson, Evans Reid)"
    },
    "remitente_email": {
      "type": "string",
      "description": "Direccion de correo electronico del remitente"
    },
    "destinatario_email": {
      "type": "string",
      "description": "Direccion de correo electronico de destino"
    },
    "asunto": {
      "type": "string",
      "description": "Linea de asunto del correo"
    },
    "cuerpo": {
      "type": "string",
      "description": "Contenido completo del mensaje en texto plano o HTML"
    },
    "snippet": {
      "type": "string",
      "description": "Extracto corto del mensaje para la vista previa de la lista"
    },
    "fecha": {
      "type": "string",
      "description": "Fecha y hora del correo en formato ISO 8601"
    },
    "leido": {
      "type": "boolean",
      "description": "Estado de lectura: false activa el punto azul indicador de no leido",
      "default": false
    },
    "destacado": {
      "type": "boolean",
      "description": "Indica si el correo ha sido marcado con estrella/favorito",
      "default": false
    },
    "categoria": {
      "type": "string",
      "description": "Categoria logistica del mensaje",
      "enum": [
        "cargas",
        "brokers",
        "general"
      ],
      "default": "cargas"
    },
    "es_logistico": {
      "type": "boolean",
      "description": "Filtro anti-ruido: true si supero el filtro y debe mostrarse en la bandeja",
      "default": true
    },
    "tipo_flujo": {
      "type": "string",
      "description": "inbox para correos recibidos, sent para correos enviados desde Trucky",
      "enum": [
        "inbox",
        "sent"
      ],
      "default": "inbox"
    },
    "load_id": {
      "type": "string",
      "description": "ID opcional de una carga relacionada creada a partir de este correo"
    },
    "google_account": {
      "type": "string",
      "description": "Cuenta de Google (ej. correo@gmail.com) desde la cual se sincroniz\u00f3 este mensaje"
    },
    "etiquetas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de etiquetas del correo (ej. IMPORTANTE, broker, carrier, trucky)"
    },
    "es_importante": {
      "type": "boolean",
      "description": "Indica si el correo tiene la etiqueta de Importante de Gmail o del usuario",
      "default": false
    },
    "thread_id": {
      "type": "string",
      "description": "ID del hilo de conversacion en Gmail (threadId) para agrupar mensajes"
    },
    "gmail_message_id": {
      "type": "string",
      "description": "ID del mensaje en la API de Gmail"
    },
    "rfc_message_id": {
      "type": "string",
      "description": "Encabezado RFC 822 Message-ID para encadenar respuestas (In-Reply-To / References)"
    }
  },
  "required": [
    "remitente_email",
    "asunto"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.google_account": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
