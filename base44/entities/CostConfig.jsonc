{
  "name": "CostConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n a la que pertenece este registro"
    },
    "usuario": {
      "type": "string",
      "description": "Email del usuario"
    },
    "diesel_precio": {
      "type": "number",
      "default": 5.5
    },
    "mpg": {
      "type": "number",
      "default": 6.5,
      "description": "Millas por gal\u00f3n"
    },
    "seguro_semanal": {
      "type": "number",
      "default": 800
    },
    "lease_semanal": {
      "type": "number",
      "default": 1200
    },
    "pago_conductor_porcentaje": {
      "type": "number",
      "default": 25
    },
    "otros_gastos_semanales": {
      "type": "number",
      "default": 300
    },
    "millas_semana_promedio": {
      "type": "number",
      "default": 2500
    },
    "costo_por_milla": {
      "type": "number"
    },
    "tarifa_break_even": {
      "type": "number"
    },
    "tarifa_objetivo": {
      "type": "number",
      "default": 3.0
    },
    "pago_camion_rpm": {
      "type": "number",
      "description": "Lo que el usuario le paga al camión por milla (RPM). Decisión 9-B: NO es dato de tabla, lo declara el usuario, se pregunta una sola vez y se reutiliza como piso cuando el estado consultado no trae piso de tabla (Florida). Sin default a propósito: su ausencia significa que todavía no se preguntó."
    }
  },
  "required": [
    "usuario"
  ]
}