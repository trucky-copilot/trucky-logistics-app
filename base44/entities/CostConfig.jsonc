{
  "name": "CostConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n a la que pertenece este registro"
    },
    "usuario": {
      "type": "string",
      "description": "Email del usuario"
    },
    "profile_id": {
      "type": "string",
      "description": "ID del perfil de simulacion"
    },
    "diesel_precio": {
      "type": "number",
      "default": 5.5
    },
    "mpg": {
      "type": "number",
      "default": 6.5,
      "description": "Millas por gal\u00f3n"
    },
    "seguro_semanal": {
      "type": "number",
      "default": 800
    },
    "lease_semanal": {
      "type": "number",
      "default": 1200
    },
    "pago_conductor_porcentaje": {
      "type": "number",
      "default": 25
    },
    "otros_gastos_semanales": {
      "type": "number",
      "default": 300
    },
    "millas_semana_promedio": {
      "type": "number",
      "default": 2500
    },
    "costo_por_milla": {
      "type": "number"
    },
    "tarifa_break_even": {
      "type": "number"
    },
    "tarifa_objetivo": {
      "type": "number",
      "default": 3.0
    },
    "pago_camion_rpm": {
      "type": "number",
      "description": "Lo que el usuario le paga al cami\u00f3n por milla (RPM). Decisi\u00f3n 9-B: NO es dato de tabla, lo declara el usuario, se pregunta una sola vez y se reutiliza como piso cuando el estado consultado no trae piso de tabla (Florida). Sin default a prop\u00f3sito: su ausencia significa que todav\u00eda no se pregunt\u00f3."
    },
    "custom_accessorials_active": {
      "type": "boolean",
      "default": false,
      "description": "Si est\u00e1 activo, usa los cargos personalizados"
    },
    "custom_accessorials_text": {
      "type": "string",
      "description": "Cargos adicionales escritos por el usuario en texto libre"
    }
  },
  "required": [
    "usuario"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}