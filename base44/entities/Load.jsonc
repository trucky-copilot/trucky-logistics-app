{
  "type": "object",
  "name": "Load",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización a la que pertenece este registro"
    },
    "profile_id": {
      "type": "string",
      "description": "ID del perfil al que pertenece esta carga"
    },
    "broker_nombre": {
      "type": "string"
    },
    "broker_email": {
      "type": "string",
      "description": "Correo electrónico del broker asociado a esta carga"
    },
    "broker_id": {
      "type": "string"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "quickload",
        "broker_directo",
        "cliente_directo"
      ],
      "default": "broker_directo"
    },
    "origen": {
      "type": "string"
    },
    "destino": {
      "type": "string"
    },
    "millas": {
      "type": "number"
    },
    "tarifa_ofrecida": {
      "type": "number"
    },
    "tarifa_negociada": {
      "type": "number"
    },
    "diesel_precio_dia": {
      "type": "number"
    },
    "costo_estimado": {
      "type": "number"
    },
    "ganancia_estimada": {
      "type": "number"
    },
    "revenue_por_milla": {
      "type": "number"
    },
    "fecha_carga": {
      "type": "string",
      "format": "date"
    },
    "fecha_entrega": {
      "type": "string",
      "format": "date"
    },
    "citas": {
      "type": "string",
      "description": "Horarios o citas de recogida y entrega (appointment window)"
    },
    "truck_placa": {
      "type": "string"
    },
    "conductor_nombre": {
      "type": "string"
    },
    "carrier_email": {
      "type": "string",
      "description": "Correo electrónico del carrier o conductor asignado"
    },
    "shared_with_carrier": {
      "type": "boolean",
      "default": false,
      "description": "True cuando el dispatcher asignó un conductor y la carga debe ser visible en la vista de cargas del rol Carrier"
    },
    "thread_id": {
      "type": "string",
      "description": "ID del hilo de Gmail desde el cual se originó esta carga"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_transito",
        "entregado",
        "cancelado"
      ],
      "default": "pendiente"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "ganancia",
        "break_even",
        "perdida"
      ],
      "default": "ganancia"
    },
    "notas": {
      "type": "string"
    },
    "numero_referencia": {
      "type": "string"
    }
  },
  "required": [
    "origen",
    "destino"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
