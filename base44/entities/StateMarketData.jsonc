{
  "name": "StateMarketData",
  "type": "object",
  "properties": {
    "state_code": {
      "type": "string",
      "description": "C\u00f3digo de 2 letras del estado, ej. FL, TX, GA"
    },
    "dry_van": {
      "type": "number",
      "description": "Tarifa estimada RPM para Dry Van en este estado"
    },
    "reefer": {
      "type": "number",
      "description": "Tarifa estimada RPM para Reefer en este estado"
    },
    "flatbed": {
      "type": "number",
      "description": "Tarifa estimada RPM para Flatbed en este estado"
    },
    "container": {
      "type": "number",
      "description": "Tarifa estimada RPM para Contenedor / Drayage en este estado"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}