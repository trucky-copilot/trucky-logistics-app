{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "usuario": {
      "type": "string",
      "description": "Email del usuario"
    },
    "rol": {
      "type": "string",
      "enum": [
        "carrier",
        "dispatcher",
        "ambos"
      ],
      "default": "dispatcher"
    },
    "cantidad_camiones": {
      "type": "string",
      "enum": [
        "1",
        "2-5",
        "6-10",
        "10+"
      ],
      "default": "1"
    },
    "onboarding_completado": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Marca este workspace como demo interno. Solo para uso explícito del equipo — nunca se activa automáticamente en cuentas reales."
    },
    "idioma_chat": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "default": "es",
      "description": "Idioma de las respuestas del Chat de Mercado. Aditivo: no forma parte del flujo de onboarding."
    },
    "nombre_completo": {
      "type": "string",
      "description": "F3-15: nombre completo del usuario (Configuración → Perfil personal)."
    },
    "telefono": {
      "type": "string",
      "description": "F3-15: teléfono de contacto."
    },
    "mc_number": {
      "type": "string",
      "description": "F3-15: número MC (solo dígitos)."
    },
    "dot_number": {
      "type": "string",
      "description": "F3-15: número DOT (solo dígitos)."
    }
  },
  "required": [
    "usuario"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}