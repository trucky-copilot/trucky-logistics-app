{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "usuario": {
      "type": "string",
      "description": "Email del usuario"
    },
    "rol": {
      "type": "string",
      "enum": [
        "carrier",
        "dispatcher",
        "ambos"
      ],
      "default": "dispatcher"
    },
    "cantidad_camiones": {
      "type": "string",
      "enum": [
        "1",
        "2-5",
        "6-10",
        "10+"
      ],
      "default": "1"
    },
    "onboarding_completado": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Marca este workspace como demo interno. Solo para uso expl\u00edcito del equipo \u2014 nunca se activa autom\u00e1ticamente en cuentas reales."
    },
    "idioma_chat": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "default": "es",
      "description": "Idioma de las respuestas del Chat de Mercado. Aditivo: no forma parte del flujo de onboarding."
    }
  },
  "required": [
    "usuario"
  ]
}