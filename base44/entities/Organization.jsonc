{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la empresa u organizaci\u00f3n"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "carrier",
        "dispatcher",
        "ambos"
      ],
      "description": "Tipo de cuenta de la organizaci\u00f3n"
    },
    "workspace_status": {
      "type": "string",
      "enum": [
        "setup",
        "production",
        "demo",
        "suspended"
      ],
      "default": "setup",
      "description": "Estado actual del workspace"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Si la organizaci\u00f3n complet\u00f3 el proceso de onboarding"
    },
    "production_ready": {
      "type": "boolean",
      "default": false,
      "description": "Si el workspace est\u00e1 listo para operar con datos reales"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si la organizaci\u00f3n est\u00e1 activa"
    },
    "created_by_user": {
      "type": "string",
      "description": "Email del usuario que creó la organización"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "ID del cliente en Stripe (cus_xxx)"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "ID de la suscripción en Stripe (sub_xxx)"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "past_due",
        "canceled",
        "unpaid",
        "incomplete",
        "none"
      ],
      "default": "none",
      "description": "Estado de la suscripción sincronizado con Stripe"
    },
    "trial_ends_at": {
      "type": "string",
      "description": "Fecha ISO del fin del periodo de prueba de 30 días"
    },
    "checkout_in_progress": {
      "type": "boolean",
      "default": false,
      "description": "Bloqueo atómico temporal para evitar dobles checkouts simultáneos"
    },
    "checkout_locked_at": {
      "type": "string",
      "description": "Timestamp ISO de cuando se inició el checkout (para TTL/expiración del bloqueo)"
    },
    "checkout_reservation_id": {
      "type": "string",
      "description": "Identificador único y verificable de la reserva de checkout activa"
    },
    "checkout_idempotency_key": {
      "type": "string",
      "description": "Clave de idempotencia estable para reintentos del mismo intento de checkout"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "ID de la sesión de Stripe Checkout (cs_test_xxx o cs_live_xxx)"
    },
    "checkout_lock_version": {
      "type": "integer",
      "default": 0,
      "description": "Versión monótona para control de concurrencia optimista (OCC)"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "none",
        "plan_29",
        "plan_99"
      ],
      "default": "none",
      "description": "Plan activo de Stripe contratado: plan_29 ($29 USD/mes) o plan_99 ($99 USD/mes)"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "ID del precio contratado en Stripe (price_xxx)"
    }
  },
  "required": [
    "name",
    "created_by_user"
  ],
  "rls": {
    "create": {
      "data.created_by_user": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.created_by_user": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by_user": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by_user": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}