{
  "name": "OrganizationMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario miembro"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member"
      ],
      "default": "member",
      "description": "Rol del usuario dentro de la organización"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si la membresía está activa"
    },
    "google_sub": {
      "type": "string",
      "description": "Identificador único y permanente de Google (sub claim del token)"
    },
    "base44_user_id": {
      "type": "string",
      "description": "Native Base44 user ID bound by trusted server migration. Never derive or accept from client-supplied email."
    }
  },
  "required": [
    "organization_id",
    "user_email",
    "role"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
