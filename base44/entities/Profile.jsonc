{
  "type": "object",
  "name": "Profile",
  "properties": {
    "name": {
      "type": "string"
    },
    "usuario": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "profile_key": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string",
      "default": "blue"
    }
  },
  "required": [
    "name",
    "usuario",
    "organization_id",
    "profile_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}