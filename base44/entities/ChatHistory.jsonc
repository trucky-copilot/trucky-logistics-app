{
  "name": "ChatHistory",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "usuario": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "structuredData": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "string"
              },
              "origen": {
                "type": "string"
              },
              "destino": {
                "type": "string"
              },
              "calculo": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "titulo": {
      "type": "string",
      "description": "Resumen corto de la conversaci\u00f3n"
    }
  },
  "required": [
    "session_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}