{
  "name": "MilesCache",
  "type": "object",
  "properties": {
    "clave": {
      "type": "string",
      "description": "El origen y destino unidos por |, en min\u00fasculas"
    },
    "millas": {
      "type": "number",
      "description": "Las millas devueltas por Google Maps"
    }
  },
  "required": [
    "clave",
    "millas"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}